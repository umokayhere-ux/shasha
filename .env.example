# ---- Core ----
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shasha?retryWrites=true&w=majority"
# MongoDB must run as a REPLICA SET (Atlas is by default) — transactions require it.
# Generate with: openssl rand -base64 48
AUTH_SECRET=
APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Paystack ----
# Server-side only. Never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Data provider ----
DATA_PROVIDER_API_URL=
DATA_PROVIDER_API_KEY=

# ---- Business ----
BUSINESS_NAME=Shasha
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
CURRENCY=GHS
CURRENCY_SYMBOL=GH₵

# ---- Notifications ----
EMAIL_ENABLED=false

# ---- Initial Super Admin (used only by `npm run admin:create`) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# ---- Vercel Cron ----
# Required. Vercel sends this as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=
