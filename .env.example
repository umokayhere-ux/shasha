# ---- Core ----
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shasha?retryWrites=true&w=majority"
# MongoDB must run as a REPLICA SET (Atlas is by default) — transactions require it.
# Generate with: openssl rand -base64 48
AUTH_SECRET=
APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Paystack ----
# Server-side only. Never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ---- Data provider ----
DATA_PROVIDER_API_URL=
DATA_PROVIDER_API_KEY=

# ---- Business ----
BUSINESS_NAME=Shasha Data Plug
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
CURRENCY=GHS
CURRENCY_SYMBOL=GH₵

# ---- Notifications ----
EMAIL_ENABLED=false

# ---- Initial Super Admin (used only by `npm run admin:create`) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# ---- Vercel Cron ----
# Required. Vercel sends this as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- SMS ---- (Arkesel)
# Your Arkesel API key. Leave blank to disable SMS entirely.
SMS_API_KEY=
# Approved sender ID, max 11 characters.
SMS_SENDER_ID=Shasha
# Optional: only set this if Arkesel changes their endpoint.
# Defaults to https://sms.arkesel.com/api/v2/sms/send
SMS_API_URL=

# ---- Support ----
# WhatsApp number complaints are sent to. Must include the country code and no
# leading zero (e.g. 233593066582). A national number is rejected rather than
# guessed at, which would open a chat with the wrong person.
SUPPORT_WHATSAPP=
